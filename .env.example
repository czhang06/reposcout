# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# memory (default, no setup) or pg (needs `docker compose up -d db`)
REPOSCOUT_STORE=memory
REPOSCOUT_EMBED_MODEL=BAAI/bge-small-en-v1.5
REPOSCOUT_CHAT_MODEL=anthropic:claude-haiku-5-5
# REPOSCOUT_CHAT_MODEL=ollama:qwen3:8b

# Answer-eval judge. claude-code:<model> runs the Claude Code CLI on your Claude plan
# (install it and run `claude` once to sign in). Or anthropic:claude-sonnet-5-5 with an API key.
REPOSCOUT_JUDGE=claude-code:sonnet
# REPOSCOUT_CLAUDE_BIN=C:/path/to/claude.exe
